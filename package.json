{
  "name": "joyrush-clone",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:api": "pnpm --filter @pauz/server dev",
    "build:api": "pnpm --filter @pauz/server build",
    "dev:admin": "pnpm --filter @pauz/admin dev",
    "build:admin": "pnpm --filter @pauz/admin build",
    "db:generate": "pnpm --filter @pauz/server prisma:generate",
    "db:deploy": "pnpm --filter @pauz/server prisma:deploy",
    "db:migrate": "pnpm --filter @pauz/server prisma:migrate",
    "db:seed": "pnpm --filter @pauz/server db:seed",
    "db:studio": "pnpm --filter @pauz/server prisma:studio",
    "seed:demo": "pnpm --filter @pauz/server seed:demo",
    "smoke": "pnpm --filter @pauz/server smoke"
  },
  "dependencies": {
    "@gsap/react": "^2.1.1",
    "framer-motion": "^11.3.19",
    "gsap": "^3.12.5",
    "lenis": "^1.1.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
